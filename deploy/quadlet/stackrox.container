[Unit]
Description=StackRox Scanner V4 (standalone, no Central)
Requires=stackrox-db.service
After=stackrox-db.service

[Container]
# Pinned to the upstream version, never :latest.
Image=quay.io/crunchtools/stackrox:5.0.0
ContainerName=stackrox
Pod=stackrox.pod
# The same podman secret, as a file only the scanner's user reads; the
# rendered config holds only its path.
Secret=stackrox-db-password,type=mount,target=/run/secrets/db-password,uid=65532,mode=0400
Environment=SCANNER_DB_PASSWORD_FILE=/run/secrets/db-password
# Certs (CA key included) and the rendered config. Mint once, keep forever.
Volume=%h/srv/stackrox/data/stackrox:/var/lib/stackrox:Z,U
# Headroom for the first bundle import; 8g is what the reference run used.
PodmanArgs=--memory=8g
Tmpfs=/tmp:rw,nosuid,size=256m
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=180

[Install]
WantedBy=default.target
